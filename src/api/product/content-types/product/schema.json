{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "compareAtPrice": {
      "type": "decimal"
    },
    "sku": {
      "type": "text",
      "unique": true
    },
    "barcode": {
      "type": "text"
    },
    "inventory": {
      "type": "biginteger",
      "default": "0",
      "min": "0"
    },
    "lowStockThreshold": {
      "type": "integer",
      "default": 10
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "products"
    },
    "variants": {
      "type": "component",
      "component": "product.product-variant",
      "repeatable": true
    },
    "specifications": {
      "type": "component",
      "component": "product.specification",
      "repeatable": true
    },
    "dimensions": {
      "type": "component",
      "component": "product.dimensions",
      "repeatable": false,
      "required": true
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "product"
    }
  }
}
